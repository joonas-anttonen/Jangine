{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "detail": "Build the project",
            "type": "process",
            "command": "meson",
            "args": [
                "compile",
                "-C",
                "${workspaceFolder}/build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run",
            "detail": "Run the project",
            "dependsOn": "Build",
            "type": "process",
            "command": ".\\Jangine.Test.exe",
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}